@{
    ViewData["Title"] = "Home Page";

}
@model AnswersModel

<body>
    <h1> Tick whichever one of these is a cat </h1>
    <form method="post">
       
        @{

            <ul>
            @for (int i = 0; i < Model.iscat.Count(); i++)
            {
                var kvp = Model.iscat.ElementAt(i);
                
                <li>
                    <input type="checkbox" name="selected" value="@kvp.Key" id="box-@i" />

                    <label for="box-@i">
                        <img src="@kvp.Value[1]"/>
                    </label>
                </li>
            }
            </ul>
        }
       
        <div class="form-action">
            <button name="button">send answers to be checked</button>
        </div>
    </form>



    @{
        if (!(ViewData["Incorrect"] == null))
        {
            Console.WriteLine((int)ViewData["Incorrect"]);
            if (((int)ViewData["Incorrect"] == 0))
            {
                <p style="color:rgb(88, 255, 0)" >YOU GOT THEM ALL RIGHT</p>
            }
            else
            {
                <p>Incorrect. You got @ViewData["Incorrect"] wrong</p>
            }
        }
    }
        
</body>